{
  "name": "yijing-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "易象图谱：用于学习《易经》的纯静态交互网站",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "video:install": "npm --prefix promo-video install",
    "video:capture": "npm --prefix promo-video run capture",
    "video:studio": "npm --prefix promo-video run dev",
    "video:render": "npm --prefix promo-video run render:all",
    "video:qa": "npm --prefix promo-video run qa",
    "test:windows": "node scripts/test-windows-build.mjs",
    "check": "node scripts/quality-check.mjs --checks-only",
    "test:unit": "node scripts/quality-check.mjs --tests-only",
    "test:smoke": "node scripts/quality-check.mjs --tests-only --include-smoke",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include=web/js/data-loader.js --test-coverage-include=web/js/guaxu-wheel.js --test-coverage-include=web/js/divination-engine.js --test-coverage-include=web/js/divination-interpretation.js --test-coverage-include=web/js/divination-history.js --test-coverage-include=web/js/evolution-state.js --test-coverage-include=web/js/hexagram-utils.js --test-coverage-include=web/js/learning-assessment.js --test-coverage-include=web/js/learning-curriculum.js --test-coverage-include=web/js/learning-progress.js --test-coverage-include=web/js/learning-review.js --test-coverage-include=web/js/meihua-engine.js --test-coverage-include=web/js/quiz-engine.js --test-coverage-include=web/js/review-engine.js --test-coverage-include=web/js/search-controller.js --test-coverage-include=web/js/star-relations.js --test-coverage-include=web/js/storage.js web/test/*.test.mjs",
    "test": "node scripts/quality-check.mjs --include-smoke",
    "validate": "node scripts/quality-check.mjs --include-smoke && npm run test:coverage"
  },
  "devDependencies": {
    "postject": "1.0.0-alpha.6"
  }
}
