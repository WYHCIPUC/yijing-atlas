{
  "name": "yijing-atlas-promo-video",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "dev:v2": "remotion studio preproduction-v2/src/index.ts",
    "capture": "node scripts/capture.mjs && node scripts/optimize.mjs",
    "analyze:bgm": "node scripts/analyze-bgm.mjs",
    "render:main": "remotion render src/index.ts YijingAtlasPromo out/yijing-atlas-promo-1080p.mp4",
    "render:v2": "remotion render preproduction-v2/src/index.ts YijingAtlasPromoV2 preproduction-v2/output/yijing-atlas-promo-v2-1080p.mp4 --image-format=png --crf=12",
    "render:v2:review": "remotion render preproduction-v2/src/index.ts YijingAtlasPromoV2 preproduction-v2/output/yijing-atlas-promo-v2-visual-review-540p.mp4 --scale=0.5 --crf=20",
    "render:v2:quality-review": "remotion render preproduction-v2/src/index.ts YijingAtlasPromoV2 preproduction-v2/output/yijing-atlas-promo-v2-quality-review-1080p.mp4 --frames=1050-2309 --image-format=png --crf=14",
    "render:v2:motion-review": "remotion render preproduction-v2/src/index.ts YijingAtlasPromoV2 preproduction-v2/output/yijing-atlas-promo-v2-motion-review-1080p.mp4 --frames=1020-3060 --image-format=png --crf=14",
    "render:v2:full-review": "remotion render preproduction-v2/src/index.ts YijingAtlasPromoV2 preproduction-v2/output/yijing-atlas-promo-v2-full-review-1080p.mp4 --image-format=png --crf=14",
    "render:douyin": "remotion render preproduction-v2/src/index.ts YijingAtlasDouyinTrailer preproduction-v2/output/yijing-atlas-douyin-trailer-1080p.mp4 --image-format=png --crf=14",
    "render:douyin:nobgm": "remotion render preproduction-v2/src/index.ts YijingAtlasDouyinTrailer preproduction-v2/output/yijing-atlas-douyin-trailer-1080p-nobgm.mp4 --props=props-nobgm.json --image-format=png --crf=14",
    "poster:douyin": "remotion still preproduction-v2/src/index.ts YijingAtlasDouyinCover preproduction-v2/output/yijing-atlas-douyin-cover-1920x1080.png --image-format=png",
    "render:douyin:short": "remotion render preproduction-v2/src/index.ts YijingAtlasDouyinShort preproduction-v2/output/yijing-atlas-douyin-short-1080p.mp4 --image-format=png --crf=14",
    "render:douyin:short:nobgm": "remotion render preproduction-v2/src/index.ts YijingAtlasDouyinShort preproduction-v2/output/yijing-atlas-douyin-short-1080p-nobgm.mp4 --props=props-nobgm.json --image-format=png --crf=14",
    "poster:douyin:short": "remotion still preproduction-v2/src/index.ts YijingAtlasDouyinShortCover preproduction-v2/output/yijing-atlas-douyin-short-cover-1920x1080.png --image-format=png",
    "render:main:nobgm": "remotion render src/index.ts YijingAtlasPromo out/yijing-atlas-promo-1080p-nobgm.mp4 --props=props-nobgm.json",
    "render:teaser": "remotion render src/index.ts YijingAtlasTeaser out/yijing-atlas-teaser-vertical.mp4",
    "render:teaser:nobgm": "remotion render src/index.ts YijingAtlasTeaser out/yijing-atlas-teaser-vertical-nobgm.mp4 --props=props-nobgm.json",
    "render:all": "node scripts/render-all.mjs",
    "render:audio-remux": "node scripts/render-audio-remux.mjs",
    "poster": "node scripts/render-posters.mjs",
    "qa": "node scripts/qa.mjs",
    "verify:renders": "node scripts/verify-renders.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "playwright-core": "1.62.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
